  "functions": [
    "FUNC.OP_UNARY_PLUS"
  ],
  "kind": "quirk",
  "title": "Unary + does not coerce text or logicals, turns a blank cell into 0, and retains computed subnormals",
  "statement": "In Excel 16.0.20527.20088, unary plus (+x) is not numeric coercion: it leaves text and logical values unchanged (+\"2\" returns text \"2\", +TRUE returns logical TRUE, unlike -\"2\" and -TRUE), evaluates a blank cell reference to 0 (+Z1 = 0), propagates errors (+#N/A = #N/A), flushes parsed subnormal literals (+1E-309 = 0), and preserves computed subnormals.",
  "status": "measured",
  "basis": "Measured across Excel 16.0.20527.20088 in jnt_operators (rows 7-11 and 18).",
