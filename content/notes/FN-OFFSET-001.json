  "functions": [
    "FUNC.OFFSET"
  ],
  "kind": "quirk",
  "title": "OFFSET defaults omitted or blank shifts to 0, extends negative height/width upward/leftward, and gives #REF! for 0",
  "statement": "In Excel 16.0.20527, OFFSET(reference, rows, cols, [height], [width]) truncates all four numeric arguments toward zero, reads omitted or blank rows/cols as 0, returns #REF! when height or width is exactly 0 (while fractions in (-1, 1) truncate to 0), extends the resulting reference upward or leftward from the shifted cell when height or width is negative, and returns #VALUE! for multi-area references or references to closed external workbooks.",
  "status": "measured",
  "basis": "Measured across 23 OFFSET rows in dcb1l_language and 2 rows in jnt_lookup in Excel 16.0.20527.20088, and matched across 4,345/4,345 full-bank OFFSET rows.",
