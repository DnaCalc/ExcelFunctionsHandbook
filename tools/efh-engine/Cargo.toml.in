[package]
name = "efh-engine"
version = "0.1.0"
edition = "2024"
license = "MIT"

[workspace]

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
dna-onecalc = { path = "@SOURCE@/apps/dna-onecalc" }
calc-func = { path = "@SOURCE@/crates/calc-func" }
serde_json = "=1.0.154"
wasm-bindgen = "=0.2.117"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
