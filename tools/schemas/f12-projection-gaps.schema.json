{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excelfunctionshandbook.local/schemas/f12-projection-gaps.schema.json",
  "title": "F12 - content/projection-gaps.json",
  "description": "The curated register of differences, upstream absences, lossy text, and inferences in the data projection, including its measurement basis and staleness warning.",
  "efh": {
    "family": "F12",
    "organ": "content",
    "path_glob": "content/projection-gaps.json",
    "writer": "T10 curation pass (human/agent)",
    "spec": "FOUNDATION.md 2.8 lines 372-376, resolving to D1-reference-structure.md 2.7 lines 380-385, plus the curated register metadata present in record version 2",
    "propertyOrderBasis": "curated-register-v2",
    "keyOrderContract": "Emit root and gap keys in propertyOrder exactly; gaps[] remains curated in gap_id order. Each measurement object uses its explicitly declared closed shape."
  },
  "type": "object",
  "additionalProperties": false,
  "propertyOrder": ["schema", "record_version", "what_this_file_is", "basis_repo", "basis_commit", "measured_over", "honesty_note", "staleness_warning", "gaps"],
  "required": ["schema", "record_version", "what_this_file_is", "basis_repo", "basis_commit", "measured_over", "honesty_note", "staleness_warning", "gaps"],
  "properties": {
    "schema": { "const": "efh.projection-gaps/v1", "type": "string" },
    "record_version": { "const": 2, "type": "integer" },
    "what_this_file_is": { "$ref": "#/$defs/nonEmptyString" },
    "basis_repo": { "const": "OxFunc", "type": "string" },
    "basis_commit": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "measured_over": { "$ref": "#/$defs/nonEmptyString" },
    "honesty_note": { "$ref": "#/$defs/nonEmptyString" },
    "staleness_warning": { "$ref": "#/$defs/nonEmptyString" },
    "gaps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gap" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "functionId": { "type": "string", "pattern": "^FUNC\\." },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": [
        "gap_id",
        "affects",
        "affects_note",
        "field",
        "observed",
        "upstream_actual",
        "kind",
        "suspected_lost",
        "verified",
        "verification_note",
        "render_as",
        "fix_owner",
        "citation",
        "corrects",
        "consequence",
        "history_note",
        "why_this_gap_is_registered_while_empty",
        "measured"
      ],
      "required": ["gap_id", "affects", "field", "observed", "upstream_actual", "kind", "render_as", "fix_owner", "citation"],
      "properties": {
        "gap_id": { "type": "string", "pattern": "^PG-" },
        "affects": {
          "oneOf": [
            { "const": "all", "type": "string" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/functionId" } }
          ]
        },
        "affects_note": { "$ref": "#/$defs/nonEmptyString" },
        "field": { "$ref": "#/$defs/nonEmptyString" },
        "observed": { "$ref": "#/$defs/nonEmptyString" },
        "upstream_actual": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["missing-in-projection-present-upstream", "wrong-in-projection", "lossy-text", "derivation-artifact", "absent-upstream-too", "authorship-inference"]
        },
        "suspected_lost": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/suspectedLostByFunction" }
          ]
        },
        "verified": { "type": "boolean" },
        "verification_note": { "$ref": "#/$defs/nonEmptyString" },
        "render_as": { "$ref": "#/$defs/nonEmptyString" },
        "fix_owner": { "type": "string", "enum": ["efh-ingest", "oxfunc", "unknown"] },
        "citation": { "$ref": "#/$defs/nonEmptyString" },
        "corrects": { "$ref": "#/$defs/nonEmptyString" },
        "consequence": { "$ref": "#/$defs/nonEmptyString" },
        "history_note": { "$ref": "#/$defs/nonEmptyString" },
        "why_this_gap_is_registered_while_empty": { "$ref": "#/$defs/nonEmptyString" },
        "measured": {
          "oneOf": [
            { "$ref": "#/$defs/xlcallMeasurement" },
            { "$ref": "#/$defs/artifactMeasurement" },
            { "$ref": "#/$defs/docsMeasurement" },
            { "$ref": "#/$defs/shortSourceMeasurement" }
          ]
        }
      }
    },
    "suspectedLostByFunction": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": ["FUNC.BAHTTEXT", "FUNC.GAMMALN", "FUNC.GAMMALN.PRECISE"],
      "required": ["FUNC.BAHTTEXT", "FUNC.GAMMALN", "FUNC.GAMMALN.PRECISE"],
      "properties": {
        "FUNC.BAHTTEXT": { "$ref": "#/$defs/nonEmptyString" },
        "FUNC.GAMMALN": { "$ref": "#/$defs/nonEmptyString" },
        "FUNC.GAMMALN.PRECISE": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "xlcallMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": ["entries_with_xlcall_null", "of"],
      "required": ["entries_with_xlcall_null", "of"],
      "properties": {
        "entries_with_xlcall_null": { "type": "integer", "minimum": 0 },
        "of": { "const": 541, "type": "integer" }
      }
    },
    "artifactMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": ["entries_with_no_artifacts", "of"],
      "required": ["entries_with_no_artifacts", "of"],
      "properties": {
        "entries_with_no_artifacts": { "type": "integer", "minimum": 0 },
        "of": { "const": 541, "type": "integer" }
      }
    },
    "docsMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": ["entries_with_docs_null", "of"],
      "required": ["entries_with_docs_null", "of"],
      "properties": {
        "entries_with_docs_null": { "type": "integer", "minimum": 0 },
        "of": { "const": 541, "type": "integer" }
      }
    },
    "shortSourceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "propertyOrder": ["microsoft_english_verbatim", "no_short_description", "differs_from_english_description", "of"],
      "required": ["microsoft_english_verbatim", "no_short_description", "differs_from_english_description", "of"],
      "properties": {
        "microsoft_english_verbatim": { "type": "integer", "minimum": 0 },
        "no_short_description": { "type": "integer", "minimum": 0 },
        "differs_from_english_description": { "type": "integer", "minimum": 0 },
        "of": { "const": 541, "type": "integer" }
      }
    }
  }
}
